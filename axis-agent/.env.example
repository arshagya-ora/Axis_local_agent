# axis-agent local environment — copy this file to `.env` and fill in real
# values. `.env` is gitignored; this example file is the committed template.
# Loaded automatically by provider_config.py (see its _load_dotenv()) for
# anything that imports it (axis/cli.py, scripts/provider_compatibility_probe.py).
# A real exported env var always overrides whatever is in .env.
#
# What each value is and where to get it: see "Step 3" in ../README.md.

# --- OCI GenAI provider config --------------------------------------------
# Region used to derive the default endpoint URL. Ignored if
# AXIS_OCI_GENAI_BASE_URL is set below.
AXIS_OCI_GENAI_REGION=us-ashburn-1

# Full endpoint URL override. Leave unset to derive it from the region above.
# AXIS_OCI_GENAI_BASE_URL=https://inference.generativeai.<region>.oci.oraclecloud.com/openai/v1

# Model alias/id, e.g. openai.gpt-5.4-mini
AXIS_OCI_GENAI_MODEL=

# GenAI project OCID (not a secret, but environment-specific — do not commit
# a real value here or anywhere else).
AXIS_OCI_GENAI_PROJECT_OCID=

# OCI CLI profile name for OciUserPrincipalAuth. Defaults to DEFAULT if unset.
AXIS_OCI_PROFILE=DEFAULT

# Optional: only set this if you already know the Responses API version the
# endpoint reports; nothing in the SDK response exposes it automatically.
# AXIS_OCI_GENAI_API_VERSION=

# --- Browser Agent Bridge client config (see browser_bridge_client.py) -----
# All optional; browser_bridge_client.py already falls back to
# 127.0.0.1:8765 and ~/.browser-agent-bridge.env for the token.
# BROWSER_AGENT_BRIDGE_HOST=127.0.0.1
# BROWSER_AGENT_BRIDGE_PORT=8765
# BROWSER_AGENT_BRIDGE_TOKEN=
