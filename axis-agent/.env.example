# axis-agent local environment — copy this file to `.env` and fill in real
# values. `.env` is gitignored; this example file is the committed template.
# Loaded automatically by provider_config.py (see its _load_dotenv()) for
# anything that imports it (axis/cli.py, scripts/provider_compatibility_probe.py).
# A real exported env var always overrides whatever is in .env.
#
# What each value is and where to get it: see "Step 3" in ../README.md.
#
# ===========================================================================
# CHOOSE ONE AUTH OPTION: A or B. Do not fill in both.
# ===========================================================================


# ---------------------------------------------------------------------------
# OPTION A — API key (simplest; use this one unless told otherwise)
#
# Paste the key you were sent. Nothing else is needed: no ~/.oci/config, no
# .pem private key, no OCI CLI. Setting AXIS_API_KEY to a non-blank value is
# what switches AXIS to key auth; leaving it empty falls through to Option B.
#
# The key IS a secret. It goes in .env (gitignored) and nowhere else — never
# in a commit, a screenshot, a ticket, or a shared doc.
# ---------------------------------------------------------------------------
AXIS_API_KEY=

# Model alias/id, e.g. openai.gpt-5.6-sol
AXIS_MODEL=

# GenAI project OCID (ocid1.generativeaiproject.oc1...). Required by the OCI
# GenAI endpoint alongside the key. Not a secret, but environment-specific —
# do not commit a real value here or anywhere else.
AXIS_OCI_GENAI_PROJECT_OCID=

# Endpoint URL. Leave commented out to use the OCI GenAI endpoint derived from
# AXIS_OCI_GENAI_REGION below. Set it only for a different OpenAI-compatible
# endpoint.
# AXIS_BASE_URL=https://inference.generativeai.us-ashburn-1.oci.oraclecloud.com/openai/v1


# ---------------------------------------------------------------------------
# OPTION B — OCI request signing (no API key)
#
# Used automatically when AXIS_API_KEY above is blank. Requires ~/.oci/config
# and the .pem signing key it points at, both in your home directory — see
# README Step 3a. The values below configure the endpoint; the credential
# itself is never read by this file.
# ---------------------------------------------------------------------------

# Region used to derive the default endpoint URL. Also used by Option A when
# AXIS_BASE_URL is not set. Ignored if a base URL is set explicitly.
AXIS_OCI_GENAI_REGION=us-ashburn-1

# Model alias/id. Only needed if AXIS_MODEL above is blank.
# AXIS_OCI_GENAI_MODEL=

# OCI CLI profile name for OciUserPrincipalAuth. Defaults to DEFAULT if unset.
AXIS_OCI_PROFILE=DEFAULT

# Optional: only set this if you already know the Responses API version the
# endpoint reports; nothing in the SDK response exposes it automatically.
# AXIS_OCI_GENAI_API_VERSION=


# ---------------------------------------------------------------------------
# Browser Agent Bridge client config (see browser_bridge_client.py)
#
# All optional; browser_bridge_client.py already falls back to 127.0.0.1:8765
# and reads your own token from ~/.browser-agent-bridge.env, which the native
# host installer generated on your machine. You normally leave all three
# commented out.
# ---------------------------------------------------------------------------
# BROWSER_AGENT_BRIDGE_HOST=127.0.0.1
# BROWSER_AGENT_BRIDGE_PORT=8765
# BROWSER_AGENT_BRIDGE_TOKEN=
